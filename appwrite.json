{
    "projectId": "69784410001fb7b91e9a",
    "projectName": "MoStudy",
    "functions": [
        {
            "$id": "ai-chat",
            "name": "AI Chat",
            "runtime": "node-18.0",
            "path": "functions/ai-chat",
            "entrypoint": "src/main.js",
            "ignore": [
                "node_modules",
                ".gitignore"
            ],
            "execute": [
                "any"
            ],
            "events": [],
            "schedule": "",
            "timeout": 900
        },
        {
            "$id": "voice-tts",
            "name": "Voice TTS",
            "runtime": "node-18.0",
            "path": "functions/voice-tts",
            "entrypoint": "src/main.js",
            "ignore": [
                "node_modules",
                ".gitignore"
            ],
            "execute": [
                "any"
            ],
            "events": [],
            "schedule": "",
            "timeout": 60
        },
        {
            "$id": "voice-stt",
            "name": "Voice STT",
            "runtime": "node-18.0",
            "path": "functions/voice-stt",
            "entrypoint": "src/main.js",
            "ignore": [
                "node_modules",
                ".gitignore"
            ],
            "execute": [
                "any"
            ],
            "events": [],
            "schedule": "",
            "timeout": 120
        }
    ],
    "databases": [
        {
            "$id": "mostudy",
            "name": "MoStudy Database"
        }
    ],
    "collections": [
        {
            "$id": "user_profiles",
            "databaseId": "mostudy",
            "name": "User Profiles",
            "permissions": [
                "read(\"users\")",
                "create(\"users\")",
                "update(\"users\")"
            ]
        },
        {
            "$id": "quiz_history",
            "databaseId": "mostudy",
            "name": "Quiz History",
            "permissions": [
                "read(\"users\")",
                "create(\"users\")",
                "update(\"users\")"
            ]
        },
        {
            "$id": "tests",
            "databaseId": "mostudy",
            "name": "Tests",
            "permissions": [
                "read(\"any\")",
                "create(\"label:admin\")",
                "update(\"label:admin\")",
                "delete(\"label:admin\")"
            ]
        },
        {
            "$id": "question_reports",
            "databaseId": "mostudy",
            "name": "Question Reports",
            "permissions": [
                "read(\"label:admin\")",
                "create(\"users\")",
                "update(\"users\")",
                "delete(\"label:admin\")"
            ]
        }
    ]
}