# Appwrite Configuration (if needed for backend/CLI)
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=69784410001fb7b91e9a
# API key with database read/write permissions (if using server-side)
APPWRITE_API_KEY=

# Hack Club AI Configuration
# Get your API key at: https://ai.hackclub.com/dashboard
# Must be 18 or under to use (free for teens)
HACK_CLUB_AI_KEY=your_api_key_here

# IMPORTANT: Set AI function environment variables in Appwrite Console
# https://cloud.appwrite.io/console/project-69784410001fb7b91e9a/functions
#
# For each function (ai-chat, voice-tts, voice-stt):
# 1. Click the function name
# 2. Go to Settings → Environment Variables
# 3. Add: HACK_CLUB_AI_KEY = your-key-here
# 4. Click Update

# Voice Feature (STT/TTS) - uses same HACK_CLUB_AI_KEY via Replicate proxy
# Replicate is in closed beta - contact hey@mahadk.com for access
# voice-tts function: resemble-ai/chatterbox-pro (judge text-to-speech)
# voice-stt function: openai/whisper (user speech-to-text)
# Both functions use HACK_CLUB_AI_KEY (same key as ai-chat)
# Falls back to browser SpeechSynthesis/SpeechRecognition if Replicate unavailable

# Optional: Set to "false" to disable voice features entirely
# (e.g., if Replicate beta access is revoked)
# VOICE_FEATURES_ENABLED=true

